<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:appointment_management_system.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        x:Class="appointment_management_system.Views.Main_header_model_doctor"
        x:DataType="vm:Main_header_model_doctor">
    <Grid Name="Top_Row_Grid" ColumnDefinitions="*,*,*,*" RowDefinitions="*">
        <Button Command = "{Binding Button_Action_View_Appointments}" Background="rgba(255, 255, 150, 1)" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="10" Grid.Column="0" Grid.Row="0" Name="Button_View_Appointments" >View Appointments</Button>
        <TextBlock Grid.Column="1" Grid.Row="0" Name="TextBlock_site_name" Text="{Binding site_name}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="2" Grid.Row="0" Name="TextBlock_user_name" Text="{Binding user_name}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Button Grid.Column="3" Grid.Row="0" Command = "{Binding Button_Action_Logout}" Background="rgba(255, 255, 150, 1)" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="10" Name="Button_Logout">Logout</Button>
    </Grid>
</UserControl>