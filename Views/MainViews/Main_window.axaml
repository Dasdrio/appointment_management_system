<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:appointment_management_system.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:v="clr-namespace:appointment_management_system.Views"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="300"
        x:Class="appointment_management_system.Views.MainWindow"
        x:DataType="vm:MainWindow_view_model"
        Icon="/../Assets/avalonia-logo.ico"
        Title="appointment_management_system"
        Height="450"
        Width="450"
        CanResize="True">
    <Window.Resources>
        <!-- Irgendwie kommt hier ständig ein Fehler
        <DataTemplate DataType="vm:Login_content_model">
            <vm:Login_content_model />
        </DataTemplate>
        <DataTemplate DataType="vm:Login_content_model">
            <vm:Impressum_content_model />
        </DataTemplate>-->
    </Window.Resources>
    <Grid Name="Main_Grid" ColumnDefinitions="*" RowDefinitions="100,*,50" Background="rgba(255, 255, 150, 1)">
        <!-- Background and Backgroundimage -->
        <Image Stretch="UniformToFill" Grid.Column="0" Grid.Row="0" Grid.RowSpan="3" Source="\..\Assets\cutefox.jpg"/>
        <Border Background="rgba(204, 229, 255, 0.95)" Grid.Row="0" ></Border>
        <Border Background="rgba(204, 229, 255, 0.95)" Grid.Row="2" ></Border>
        <!-- Standardbuttons 
        <Grid Grid.Column="0" Grid.Row="0" Name="Top_Row_Grid" ColumnDefinitions="*,*" RowDefinitions="*">
            <Button Command = "{Binding Button_Action_Redirect_Login}" Background="rgba(255, 255, 150, 1)" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="10" Grid.Column="0" Grid.Row="0" Name="Button_Redirect_Login" >Zum Login</Button>
            <Button Command = "{Binding Button_Action_Redirect_Register}" Background="rgba(255, 255, 150, 1)" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="10" Grid.Column="1" Grid.Row="0" Name="Button_Redirect_Register">Zum Registeren</Button>
        </Grid>-->
        <ContentControl Grid.Row="0" Grid.Column="0" Content="{Binding current_header}"/>
        <ContentControl Grid.Row="1" Grid.Column="0" Content="{Binding current_content}"/>
        <StackPanel Grid.Column="0" Grid.Row="2" Name="Bottom_Row_Grid" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Command = "{Binding button_action_impressum}" Background="rgba(255, 255, 150, 1)" VerticalContentAlignment="Center"  HorizontalContentAlignment="Center" VerticalAlignment="Stretch" Margin="5" Name="Button_Impressum" >Impressum</Button>
            <Button Command = "{Binding button_action_AGB}" Background="rgba(255, 255, 150, 1)" VerticalContentAlignment="Center"  HorizontalContentAlignment="Center" VerticalAlignment="Stretch" Margin="5" Name="Button_AGB">AGB</Button>
            <Button Command = "{Binding button_action_contact}" Background="rgba(255, 255, 150, 1)" VerticalContentAlignment="Center"  HorizontalContentAlignment="Center" VerticalAlignment="Stretch" Margin="5"  Name="Button_Contact" >Contact</Button>
            <Button Command = "{Binding button_action_data_security_information}" Background="rgba(255, 255, 150, 1)" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" VerticalAlignment="Stretch" Margin="5" Name="Button_Data_Security_Information">Data Security Information</Button>
        </StackPanel>
    </Grid>
</Window>
