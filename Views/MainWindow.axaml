<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:appointment_management_system.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="appointment_management_system.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="appointment_management_system">
    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>
    <Grid Name="Main_Grid" ColumnDefinitions="*" RowDefinitions="100,*,50">
        <!-- Background and Backgroundimage -->
        <Image Stretch="UniformToFill" Grid.Column="0" Grid.Row="0" Grid.RowSpan="3" Source="..\Assets\wartezimmer.jpg"/>
        <Border Background="rgba(204, 229, 255, 0.95)" Grid.Row="0" ></Border>
        <Border Background="rgba(204, 229, 255, 0.95)" Grid.Row="2" ></Border>
        <!-- Standardbuttons -->
        <Grid Grid.Column="0" Grid.Row="0" Name="Top_Row_Grid" ColumnDefinitions="*,*,*,*,*" RowDefinitions="*">
            <Button Command = "{Binding Button_Action_View_Appointments}" Background="rgba(255, 255, 150, 1)" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="10" Grid.Column="0" Grid.Row="0" Name="Button_View_Appointments" >View Appointments</Button>
            <Button Command = "{Binding Button_Action_Make_Appointments}" Background="rgba(255, 255, 150, 1)" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="10" Grid.Column="1" Grid.Row="0" Name="Button_Make_Appointments">Make Appointments</Button>
            <TextBlock Grid.Column="2" Grid.Row="0" Name="TextBlock_Site_Name" Text="{Binding Site_Name}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="3" Grid.Row="0" Name="TextBlock_User_Name" Text="{Binding User_Name}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Button Command = "{Binding Button_Action_Logout}" Background="rgba(255, 255, 150, 1)" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="10" Grid.Column="4" Grid.Row="0" Name="Button_Logout">Logout</Button>
        </Grid>
        <Grid Grid.Column="0" Grid.Row="1" Name="Content_Grid" ColumnDefinitions="*" RowDefinitions="*">

        </Grid>
        <Grid Grid.Column="0" Grid.Row="2" Name="Bottom_Row_Grid" ColumnDefinitions="*,*,*,*" RowDefinitions="*">
            <Button Command = "{Binding Button_Action_Impressum}" Background="rgba(255, 255, 150, 1)" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="10" Grid.Column="0" Grid.Row="0" Name="Button_Impressum" >Impressum</Button>
            <Button Command = "{Binding Button_Action_AGB}" Background="rgba(255, 255, 150, 1)" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="10" Grid.Column="1" Grid.Row="0" Name="Button_AGB">AGB</Button>
            <Button Command = "{Binding Button_Action_Contact}" Background="rgba(255, 255, 150, 1)" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="10" Grid.Column="2" Grid.Row="0" Name="Button_Contact" >Contact</Button>
            <Button Command = "{Binding Button_Action_Data_Security_Information}" Background="rgba(255, 255, 150, 1)" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="10" Grid.Column="3" Grid.Row="0" Name="Button_Data_Security_Information">Data Security Information</Button>
        </Grid>
    </Grid>


</Window>
