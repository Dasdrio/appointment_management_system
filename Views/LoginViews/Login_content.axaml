<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:appointment_management_system.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        x:Class="appointment_management_system.Views.Login_content_model"
        x:DataType="vm:Login_content_model">
    <Grid ColumnDefinitions="*" RowDefinitions="*,*,*,*"> 
        <TextBox Grid.Row="0" Name="user_name" Text="{Binding user_name}" FontSize="20"/>
        <TextBox Grid.Row="1" Name="password" Text="{Binding password}" PasswordChar="☺" FontSize="20"/>
        <Button Grid.Row="2"  Command="{Binding button_action_login}" FontSize="20" >Login</Button>
        <TextBlock Grid.Row="3" Name="Message" Text="{Binding message}" FontSize="20"/>
    </Grid>
</UserControl>
